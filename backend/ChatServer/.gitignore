```gitignore
# ==========================================
# OS / System
# ==========================================

.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo


# ==========================================
# Environment / Secrets
# ==========================================

.env
.env.*
!.env.example

*.local

# Spring profiles / local configuration
application-local.yml
application-local.yaml
application-local.properties


# ==========================================
# Java / Maven / Spring Boot
# ==========================================

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# Gradle (in case we use it later)
.gradle/
build/

# Java compiled files
*.class
*.jar
*.war
*.ear

# Spring Boot
*.log


# ==========================================
# Node / React / TypeScript
# ==========================================

# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/

# Vite
.vite/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# npm
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.pnpm-store/


# ==========================================
# IDEs
# ==========================================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/.nb-gradle/


# ==========================================
# Docker
# ==========================================

# Docker override files
docker-compose.override.yml

# Local Docker environment
.docker/

# Docker volumes / local persistent data
docker-data/
docker-volumes/


# ==========================================
# Logs
# ==========================================

logs/
*.log
*.log.*
log/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# ==========================================
# Test / Coverage
# ==========================================

*.coverage
.coverage
.pytest_cache/
htmlcov/

# Playwright
test-results/
playwright-report/


# ==========================================
# Temporary / Generated Files
# ==========================================

tmp/
temp/
*.tmp
*.temp

*.bak
*.swp
*.swo

*.pid
*.seed


# ==========================================
# Local Development
# ==========================================

.local/
.local-data/

# Generated configuration
generated/


# ==========================================
# Database / Local Data
# ==========================================

# Local database files
*.db
*.sqlite
*.sqlite3

# Cassandra local data
cassandra-data/

# MySQL local data
mysql-data/

# Kafka local data
kafka-data/


# ==========================================
# Project-specific
# ==========================================

# Load test results
load-generator/results/
load-generator/reports/

# Performance experiment output
docs/experiments/results/
docs/performance/results/

# Local chaos experiment output
inferno-results/


# ==========================================
# Keep example files
# ==========================================

!.env.example
!**/.env.example
```
